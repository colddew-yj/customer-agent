# customer-helpmesh-agent 默认配置示例
# 复制为 agent.yaml 后修改

llm:
  provider: openai          # openai | anthropic | deepseek | ollama
  model: gpt-4o-mini
  base_url: null
  api_key_env: OPENAI_API_KEY
  temperature: 0.3

embedding:
  # provider 选型：
  #   openai    — OpenAI / Azure / OpenRouter 兼容代理
  #   dashscope — 阿里云 DashScope（国内）
  #   ollama    — 本地 Ollama
  #   huggingface — HuggingFace 模型
  #   fake      — 测试用（deterministic random vector）
  provider: openai
  model: text-embedding-3-small
  base_url: null
  api_key_env: OPENAI_API_KEY

vector_store:
  provider: chroma
  persist_dir: ./data/chroma
  collection_name: knowledge

retriever:
  strategy: hybrid            # vector | hybrid | multiquery | hyde
  top_k: 5
  fetch_k: 10
  fusion: rrf                # 当 strategy=hybrid：rrf | weighted
  bm25_tokenizer: jieba
  rerank: true               # V3 默认开 cross-encoder 精排（需要 FlagEmbedding）
  rerank_model: BAAI/bge-reranker-v2-m3
  rerank_top_n: 20           # 召回多少候选送 reranker
  multi_query: { n_variants: 3 }
  hyde: { enabled: false }

knowledge:
  sources:
    # ────── 本地（dev / 小库） ──────
    - name: faq-local
      path: ./knowledge/faq
      glob: "**/*.md"
      format: md
      chunk_size: 500
      chunk_overlap: 50
      metadata_tags: { category: faq }

    # ────── S3 / R2 / MinIO / 阿里云 OSS ──────
    - name: wiki-s3
      connector: s3
      connector_config:
        bucket: company-wiki
        prefix: docs/
        endpoint_url: https://s3.amazonaws.com   # R2: https://<accountid>.r2.cloudflarestorage.com
        aws_key_env: AWS_ACCESS_KEY_ID
        aws_secret_env: AWS_SECRET_ACCESS_KEY
        region: us-east-1

    # ────── Git 仓库 ──────
    - name: kb-git
      connector: git
      connector_config:
        repo_url: https://github.com/me/kb.git
        branch: main
        path_filter: "docs/*.md"

    # ────── Notion database ──────
    - name: faq-notion
      connector: notion
      connector_config:
        api_key_env: NOTION_API_KEY
        database_id: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
        title_property: Name

tools:
  - name: query_balance
    endpoint: https://api.example.com/v1/users/me/balance
    method: GET
    auth: bearer
    auth_header: Authorization
    response_path: data.balance

intents:
  - name: faq
    handler: builtin:faq
    description: 业务问答
    uses_rag: true
  - name: account
    handler: builtin:account
    description: 账户问题
    uses_rag: false
    uses_tools: [query_balance]
  - name: complaint
    handler: builtin:complaint
    description: 用户不满
    uses_rag: false
  - name: chat
    handler: builtin:chat
    description: 闲聊
    uses_rag: false
  - name: refuse
    handler: builtin:refuse
    description: 跟业务无关
    uses_rag: false

server:
  host: 0.0.0.0
  port: 8000
  cors_origins: ["*"]
  heartbeat_seconds: 15

assistant_name: 客服助理
brand_name: MyProduct

# 可选（pydantic 接受 extra 字段，未在 schema 声明）
refuse_message: "这个问题跟 {brand} 业务无关，我暂时帮不上忙。"